# Box demo instance URL (no trailing slash)
BOX_DEMO_URL=https://your-enterprise.app.box.com

# Optional: path to a saved browser session/cookies file (never commit real cookies)
# BOX_SESSION_FILE=./data/box-session.json

# Cursor SDK API key for batch eval runs (scripts/run_evals.ts)
CURSOR_API_KEY=

# Eval pass threshold (0.0 - 1.0)
EVAL_PASS_THRESHOLD=0.8

# Human rating learning loop thresholds
HUMAN_RATING_LOW_THRESHOLD=6
HUMAN_RATING_HIGH_THRESHOLD=9
GRADER_HUMAN_DELTA_THRESHOLD=0.25

# Model for SDK eval orchestration
CURSOR_MODEL=composer-2.5
